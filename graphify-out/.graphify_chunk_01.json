{"id":"readme_insurgo_field_review","label":"Insurgo Field Review PCF Controls","file_type":"document","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L1","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Adds a '+' comment/assignment thread to a model-driven form field; a comment resolved by any assignee is resolved for everyone; full history visible to all."},
{"id":"readme_fieldreviewcontrol","label":"FieldReviewControl","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L20","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_fieldreviewlookupcontrol","label":"FieldReviewLookupControl","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L24","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_fieldreviewchoicecontrol","label":"FieldReviewChoiceControl","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L27","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_fieldreviewpolylookupcontrol","label":"FieldReviewPolyLookupControl","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L29","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Bound to a text column that hosts the control and names the review thread; the selection itself lives in an N:N, custom intersect or Connection relationship and is saved immediately via Web API."},
{"id":"readme_one_control_per_field_family","label":"One Control Per Field Family","file_type":"rationale","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L8","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A bound property can declare only one type-group; mixing Lookup.Simple or OptionSet with scalars is undocumented and pcf-scripts only passes by falling back to untyped Property, so rather than gamble on runtime binding the project ships one control per family from a single PCF project."},
{"id":"readme_shared_dropdown","label":"Shared Dropdown (Lookup and Choice)","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L35","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Lookup and Choice render with the same dropdown so both field types look and behave the same: plain list with '---' for no value, disabled when read-only."},
{"id":"readme_readonly_when_disabled","label":"Read-only Only When Field Disabled","file_type":"rationale","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L40","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_shared_common_folder","label":"Shared common/ Folder","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L44","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"One copy of settings parsing, Web API calls, panel UI and pickers, imported via ../common and bundled separately into each control's bundle.js."},
{"id":"readme_fieldreview_css","label":"Shared Stylesheet common/css/FieldReview.css","file_type":"code","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L53","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_fieldreview_pcfproj","label":"FieldReview.pcfproj","file_type":"code","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L50","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_review_settings_json","label":"Review Settings JSON","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L65","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Nothing about table/column naming is hardcoded so the same compiled control works across environments and publisher prefixes."},
{"id":"readme_render_label","label":"renderLabel / labelWidth / panelPlacement","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L104","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A control cannot draw into the form's own label, so renderLabel draws its own and the form label must be hidden."},
{"id":"readme_lookup_mode","label":"lookupMode (simple / search / auto)","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L127","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_lookup_allow_create","label":"lookupAllowCreate Quick Create","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L128","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_lookup_candidate_filter","label":"lookupCandidateFilter OData Filter","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L130","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_regarding_mode","label":"regardingMode (Linking Comments to Parent Record)","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L142","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_regarding_text_mode","label":"Regarding Text Mode","file_type":"rationale","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L147","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"One comment table serves any parent table with no schema changes; trade-off: no clickable link, no native subgrid, no cascade delete."},
{"id":"readme_regarding_lookup_mode","label":"Regarding Lookup Mode","file_type":"rationale","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L153","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Real Lookup column gives clickable link, subgrid and cascade delete at the cost of one Lookup column per parent table; switching from text mode does not migrate old comments."},
{"id":"readme_polylookup_relationship_types","label":"PolyLookup Relationship Types (manyToMany / custom / connection)","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L189","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_polylookup_output","label":"polyLookupOutput (none / text / json)","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L136","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Selection copied to the bound column only on user change so opening a record never marks the form dirty; json output enables picking on create forms."},
{"id":"readme_create_form_json_plugin","label":"Create-Form JSON + Post-Create Plugin","file_type":"rationale","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L230","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Records cannot be related before the current record exists, so choices are written as JSON and a post-operation Create plugin makes the associations."},
{"id":"readme_dce_polylookup","label":"DCE PolyLookup","file_type":"document","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L30","source_url":"https://github.com/khoait/DCE.PCF/wiki/PolyLookup","captured_at":null,"author":null,"contributor":null},
{"id":"readme_associate_polylookup_plugin","label":"AssociatePolyLookup Sample Plugin","file_type":"document","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L236","source_url":"https://github.com/khoait/DCE.PCF/blob/main/Samples/DCE.PCF/DCE.PCF.Plugins/AssociatePolyLookup.cs","captured_at":null,"author":null,"contributor":null},
{"id":"readme_comment_table","label":"Comment Table (insurgo_reviewcomment)","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L245","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_assignment_table","label":"Assignment Table (insurgo_reviewassignment)","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L257","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Records only who is assigned to which comment, one row per person, with no status of its own."},
{"id":"readme_comment_level_status","label":"Comment-Level Resolve Status","file_type":"rationale","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L5","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Any one assignee resolving a comment resolves it for everyone; status lives on the comment row, replacing the earlier per-assignee status."},
{"id":"readme_per_assignee_status_migration","label":"Migration From Per-Assignee Status","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L268","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Control refuses to load while old assignmentStatus*/assignmentCompletedOnAttribute keys remain, so outdated config can't go unnoticed."},
{"id":"readme_contextinfo_record_detection","label":"Current Record Detection via context.mode.contextInfo","file_type":"rationale","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L289","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Undocumented for field-bound controls but a well-established community workaround; URL parsing of etn/id is the fragile last-resort fallback."},
{"id":"readme_getentitymetadata","label":"Table Metadata via context.utils.getEntityMetadata","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L299","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Reads EntitySetName, PrimaryIdAttribute, PrimaryNameAttribute; PrimaryIdAttribute matters for activity tables (task key is activityid)."},
{"id":"readme_navigation_property_resolution","label":"Lookup Navigation Property Resolution","file_type":"rationale","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L306","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"@odata.bind requires the case-sensitive navigation property, often not the logical name; read from relationship metadata via direct Web API, falling back to logical name or *NavigationProperty override."},
{"id":"readme_multi_target_native_dialog","label":"Multi-Target Lookup Forces Native Dialog","file_type":"rationale","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L317","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Merging candidates from several tables in one dropdown is a bigger feature than the control takes on."},
{"id":"readme_clear_value_undefined","label":"Clearing Value via undefined from getOutputs","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L322","source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"readme_direct_web_api_calls","label":"Direct Web API Calls (metadata, $ref associate)","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L327","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"PCF webAPI cannot query metadata or send N:N associate/disassociate, so same-origin direct calls are used."},
{"id":"readme_polylookup_type_group","label":"PolyLookup Text Type-Group","file_type":"concept","source_file":"E:\\PCFFieldReview\\README.md","source_location":"L335","source_url":null,"captured_at":null,"author":null,"contributor":null},
