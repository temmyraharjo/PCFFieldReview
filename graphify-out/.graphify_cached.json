{"nodes": [{"id": "build_building_and_deploying", "label": "Building and Deploying Guide", "file_type": "document", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_single_pcf_project", "label": "Single PCF Project (FieldReview.pcfproj)", "file_type": "concept", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All four controls always build together from one project; one solution reference brings in all four controls."}, {"id": "build_one_step_build", "label": "One-step build (build.cmd)", "file_type": "concept", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended path: npm build, then version bump, then dotnet package. Stops before touching versions if the build fails."}, {"id": "build_version_bump", "label": "Control and Solution Version Bumping", "file_type": "rationale", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dataverse may keep serving the cached older bundle unless the control manifest version increases before each import or push; build.cmd bumps automatically, pac pcf push does not."}, {"id": "build_solution_packaging", "label": "Package into Dataverse Solution", "file_type": "concept", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solution lives in its own Solution/ folder because the repo root is the PCF project itself."}, {"id": "build_insurgoreviewcontrols_zip", "label": "InsurgoReviewControls.zip", "file_type": "concept", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_managed_vs_unmanaged", "label": "Managed vs Unmanaged Solution (SolutionPackageType)", "file_type": "rationale", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Managed is right for test/production: cannot be edited in target and deletes cleanly. Do not import over an unmanaged copy, which sits on top and keeps winning."}, {"id": "build_quick_deploy_pac_pcf_push", "label": "Quick deploy with pac pcf push", "file_type": "concept", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_power_platform_cli", "label": "Power Platform CLI (pac)", "file_type": "concept", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_skip_build_linting", "label": "skipBuildLinting in pcfconfig.json", "file_type": "rationale", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build-time ESLint is off because the project ships no ESLint config; add eslint.config.mjs and remove the flag to lint."}, {"id": "build_test_harness", "label": "Local test harness (npm start watch)", "file_type": "concept", "source_file": "E:\\PCFFieldReview\\BUILD.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows only the first control and is not connected to Dataverse, so comment threads and lookup records do not load."}, {"id": "build_form_control_binding", "label": "Adding controls to form fields", "file_type": "concept", "source_file": "E:\\PCFFieldReview\\BUIL