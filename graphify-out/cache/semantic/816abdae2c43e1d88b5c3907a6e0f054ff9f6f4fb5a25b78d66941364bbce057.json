{"nodes": [{"id": "readme_insurgo_field_review", "label": "Insurgo Field Review PCF Controls", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_comment_assignment_thread", "label": "Field comment/assignment thread", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each comment is open until any one assignee resolves it, resolving it for everyone; full history visible to all."}, {"id": "readme_one_control_per_field_family", "label": "One control per field family", "file_type": "rationale", "source_file": "README.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bound property declares one type-group; mixing Lookup.Simple or OptionSet with scalar types is undocumented and pcf-scripts falls back to untyped Property, so rather than gamble on runtime binding, ship one control per family from a single project."}, {"id": "readme_fieldreviewcontrol", "label": "FieldReviewControl", "file_type": "concept", "source_file": "README.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fieldreviewlookupcontrol", "label": "FieldReviewLookupControl", "file_type": "concept", "source_file": "README.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fieldreviewchoicecontrol", "label": "FieldReviewChoiceControl", "file_type": "concept", "source_file": "README.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fieldreviewpolylookupcontrol", "label": "FieldReviewPolyLookupControl", "file_type": "concept", "source_file": "README.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bound to a text column that hosts the control and names the review thread; the selection itself lives in a relationship saved immediately via Web API."}, {"id": "readme_dce_polylookup", "label": "DCE PolyLookup", "file_type": "concept", "source_file": "README.md", "source_location": "L30", "source_url": "https://github.com/khoait/DCE.PCF/wiki/PolyLookup", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shared_dropdown", "label": "Shared dropdown (common/dropdown.ts)", "file_type": "concept", "source_file": "README.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lookup and Choice controls render with the same dropdown so both field types look and behave the same."}, {"id": "readme_shared_common_folder", "label": "Shared common/ folder", "file_type": "concept", "source_file": "README.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One copy of settings parsing, Web API calls, panel UI and pickers; webpack bundles it into each control's bundle.js separately."}, {"id": "readme_readonly_when_disabled", "label": "Read-only only when field disabled", "file_type": "rationale", "source_file": "README.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_settings_json", "label": "Review settings (JSON)", "file_type": "concept", "source_file": "README.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing about table/column naming is hardcoded, so the same compiled control works across environments and publisher prefixes."}, {"id": "readme_lookup_mode", "label": "lookupMode (simple/search/auto)", "file_type": "concept", "source_file": "README.md", "source_location": "L127", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_polylookup_output", "label": "polyLookupOutput (none/text/json)", "file_type": "concept", "source_file": "README.md", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_regarding_mode", "label": "regardingMode (text vs lookup)", "file_type": "rationale", "source_file": "README.md", "source_location": "L142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Text mode: one comment table serves any parent with no schema change, but no clickable link, subgrid or cascade delete. Lookup mode restores those at the cost of one Lookup column per parent table."}, {"id": "readme_polylookup_relationship_types", "label": "PolyLookup relationship types (manyToMany/custom/connection)", "file_type": "concept", "source_file": "README.md", "source_location": "L189", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_create_form_json_plugin", "label": "Create-form selection via JSON + post-operation plugin", "file_type": "rationale", "source_file": "README.md", "source_location": "L230", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records cannot be related before the current record exists; JSON output in DCE PolyLookup shape lets a Create plugin make the associations."}, {"id": "readme_comment_table", "label": "Comment table (insurgo_reviewcomment)", "file_type": "concept", "source_file": "README.md", "source_location": "L245", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_assignment_table", "label": "Assignment table (insurgo_reviewassignment)", "file_type": "concept", "source_file": "README.md", "source_location": "L257", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only records who is assigned to which comment, one row per person; has no status of its own."}, {"id": "readme_comment_level_status_migration", "label": "Migration from per-assignee status to comment status", "file_type": "rationale", "source_file": "README.md", "source_location": "L268", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Control refuses to load while old assignmentStatus* keys remain so an outdated config cannot go unnoticed."}, {"id": "readme_contextinfo_record_detection", "label": "Current record detection via context.mode.contextInfo", "file_type": "rationale", "source_file": "README.md", "source_location": "L289", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Undocumented for field-bound controls but a long-standing community workaround; URL parsing is the fragile last-resort fallback."}, {"id": "readme_entity_metadata", "label": "Table metadata via context.utils.getEntityMetadata", "file_type": "rationale", "source_file": "README.md", "source_location": "L299", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads EntitySetName, PrimaryIdAttribute, PrimaryNameAttribute; PrimaryIdAttribute matters for activity tables (activityid not taskid)."}, {"id": "readme_navigation_property_resolution", "label": "Lookup navigation property resolution", "file_type": "rationale", "source_file": "README.md", "source_location": "L306", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@odata.bind requires the case-sensitive navigation property, often not the logical name; read from relationship metadata via direct Web API, fallback to logical name with *NavigationProperty overrides."}, {"id": "readme_multi_target_native_dialog", "label": "Multi-target lookup forces native search dialog", "file_type": "rationale", "source_file": "README.md", "source_location": "L317", "source_url": null, "captured_at": null, "author": nu