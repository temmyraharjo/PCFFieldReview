<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Insurgo" constructor="FieldReviewPolyLookupControl" version="1.0.17" display-name-key="FieldReviewPolyLookupControl_Display" description-key="FieldReviewPolyLookupControl_Desc" control-type="standard">

    <!-- The same text family DCE PolyLookup binds to. The column only hosts the control
         (and optionally receives the selection as text/JSON); the selection itself lives
         in the relationship. -->
    <type-group name="text">
      <type>SingleLine.Text</type>
      <type>SingleLine.TextArea</type>
      <type>Multiple</type>
    </type-group>

    <property name="value"
              display-name-key="Value_Display"
              description-key="Value_Desc"
              of-type-group="text"
              usage="bound"
              required="true" />

    <property name="settingsJson"
              display-name-key="SettingsJson_Display"
              description-key="SettingsJson_Desc"
              of-type="Multiple"
              usage="input"
              required="true" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="../common/css/FieldReview.css" order="1" />
      <resx path="strings/FieldReviewPolyLookupControl.1033.resx" version="1.0.0" />
    </resources>

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
      <uses-feature name="Utility" required="true" />
    </feature-usage>

  </control>
</manifest>
